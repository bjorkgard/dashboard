Screen {
    background: #10141b;
    color: #d8dee9;
}

#masthead {
    height: 4;
    padding: 1 3 0 3;
}

#brand {
    width: 1fr;
    color: #eceff4;
    text-style: bold;
}

#release {
    width: 24;
    color: #8b95a7;
    text-align: right;
}

#settings-open {
    width: 16;
    min-width: 16;
    height: 3;
}

#mode {
    height: auto;
    min-height: 2;
    padding: 0 3;
    color: #d7b875;
}

.workspace-scroll {
    height: 1fr;
    padding: 0 3 1 3;
}

#workspace-tabs {
    height: 1fr;
}

TabPane {
    padding: 0;
    height: 1fr;
}

.detail-note {
    height: auto;
    padding: 1 0;
    color: #8b95a7;
}

#clock {
    height: 4;
    color: #eceff4;
    text-style: bold;
    padding-top: 1;
}

#section-title {
    height: 2;
    color: #8b95a7;
}

#cards {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: auto;
    height: auto;
}

.card {
    height: auto;
    min-height: 9;
    padding: 1 2;
    border: solid #303b4c;
    background: #171d27;
}

#news-notice {
    height: auto;
    min-height: 3;
    padding: 1 0;
    color: #88c0d0;
}

#scope {
    height: auto;
    color: #8b95a7;
    margin-bottom: 1;
}

Footer {
    background: #1b2330;
}

#mail-boxes {
    height: 8;
}

ConfirmWarpDisconnect {
    align: center middle;
}

#warp-confirm {
    width: 72;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    border: solid #88c0d0;
    background: #171d27;
}

#warp-confirm Horizontal {
    height: 3;
}

#warp-confirm Button {
    width: 1fr;
}

#welcome-scroll {
    padding: 1 3;
}

#welcome {
    height: auto;
    max-width: 90;
    border: solid #303b4c;
    padding: 1 3;
    background: #171d27;
}

#welcome-title {
    height: 2;
    color: #88c0d0;
    text-style: bold;
}

#welcome-copy {
    height: auto;
}

#setup-error {
    height: auto;
    color: #ef9a9a;
    margin: 1 0;
}

#welcome-actions, #settings-actions {
    height: 3;
    padding: 0 3;
}

#welcome-actions Button, #settings-actions Button {
    width: 1fr;
    margin: 0 1;
}

#settings-title {
    height: 2;
    padding: 0 3;
    text-style: bold;
    color: #88c0d0;
}

#settings-hint {
    height: 2;
    padding: 0 3;
    color: #8b95a7;
}

#settings-message {
    height: 3;
    padding: 0 3;
    color: #d7b875;
}

#settings-form {
    height: 1fr;
    padding: 0 3;
}

.settings-panel {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: solid #303b4c;
    background: #171d27;
}

.settings-section {
    height: 2;
    color: #88c0d0;
    text-style: bold;
}

.settings-note, .settings-label {
    height: auto;
    color: #8b95a7;
}

.settings-label {
    margin-top: 1;
}

.settings-toggle {
    height: 3;
}

.settings-toggle Static {
    width: 1fr;
    height: 3;
    padding-top: 1;
}

.settings-pair {
    height: 5;
}

.settings-pair Vertical {
    width: 1fr;
    height: 5;
}

.settings-pair Vertical:first-child {
    margin-right: 1;
}
